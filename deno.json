{
  "tasks": {
    "test": "deno test --allow-env"
  },
  "workspace": [
    "packages/*",
    "packages/content/*",
    "packages/studio/*",
    "packages/delivery/*",
    "examples/*"
  ],
  "lint": {
    "rules": {
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-eval",
        "no-external-import",
        "no-implicit-declare-namespace-export",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-undef",
        "no-useless-rename",
        "prefer-ascii",
        "single-var-declarator"
      ],
      "tags": ["jsr", "recommended", "workspace"]
    }
  },
  "imports": {
    "@deno-lint/plugin-jsx-a11y": "jsr:@deno-lint/plugin-jsx-a11y@^0.1.0",
    "@deno-lint/plugin-react-hooks": "jsr:@deno-lint/plugin-react-hooks@^0.1.0",
    "@js-temporal/polyfill": "npm:@js-temporal/polyfill@^0.5.1",
    "@miyauci/graphql-builder": "jsr:@miyauci/graphql-builder@^1.0.0-beta.2",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing": "jsr:@std/testing@^1.0.21"
  },
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },

  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0
}

{
  "tasks": {
    "test": "deno test --allow-env"
  },
  "workspace": [
    "packages/*",
    "packages/codecs/*",
    "packages/locators/*",
    "packages/protocols/*",
    "packages/stores/*",
    "packages/storages/*",
    "packages/formatters/*",
    "packages/node/*",
    "packages/graphql/*",
    "packages/converters/*",
    "examples/*"
  ],
  "lint": {
    "rules": {
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-eval",
        "no-external-import",
        "no-implicit-declare-namespace-export",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-undef",
        "no-useless-rename",
        "prefer-ascii",
        "single-var-declarator"
      ]
    }
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "@miyauci/graphql-builder": "jsr:@miyauci/graphql-builder@^1.0.0-beta.2",
    "@std/expect": "jsr:@std/expect@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.18"
  },
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "exclude": ["./**/*/npm", "./**/*/scripts"]
}

{
  "name": "@cosmos/studio-graphql",
  "exports": "./src/mod.ts",
  "imports": {
    "@graphql-codegen/cli": "npm:@graphql-codegen/cli@^7.4.2",
    "@graphql-codegen/typescript-graphql-request": "npm:@graphql-codegen/typescript-graphql-request@^7.1.0",
    "@graphql-codegen/typescript-operations": "npm:@graphql-codegen/typescript-operations@^6.1.7",
    "@graphql-typed-document-node/core": "npm:@graphql-typed-document-node/core@^3.2.0",
    "@parcel/watcher": "npm:@parcel/watcher@^2.6.0",
    "graphql": "npm:graphql@^17.0.2",
    "graphql-request": "npm:graphql-request@^7.4.0"
  },
  "tasks": {
    "watch": "deno x graphql-code-generator --config ./.graphqlrc.yaml --watch",
    "generate": "deno x graphql-code-generator --config ./.graphqlrc.yaml"
  },
  "exclude": ["./src/generated/*"]
}

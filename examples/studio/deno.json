{
  "tasks": {
    "dev": {
      "dependencies": ["watch", "serve"]
    },
    "serve": "deno serve -A --unstable-no-legacy-abort --unstable-bundle --unstable-raw-imports --watch main.ts",
    "watch": "deno run -A --unstable-bundle --unstable-raw-imports --watch=./client.tsx build.ts"
  },
  "imports": {
    "@std/collections": "jsr:@std/collections@^1.3.0",
    "@std/http": "jsr:@std/http@^1.1.2",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@types/react": "npm:@types/react@^19.2.17",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "react": "npm:react@^19.2.7",
    "react-dom": "npm:react-dom@^19.2.7"
  },
  "compilerOptions": {
    "jsx": "react-jsx"
  },
  "exclude": ["dist"]
}

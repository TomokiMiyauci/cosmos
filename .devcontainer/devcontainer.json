{
  "name": "Deno",
  "image": "denoland/deno",
  "customizations": {
    "vscode": {
      "extensions": [
        "denoland.vscode-deno",
        "vivaxy.vscode-conventional-commits",
        "42crunch.vscode-openapi"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  }
}
